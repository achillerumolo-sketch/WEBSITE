# Copia questo file in ".env" e inserisci le tue chiavi reali.
# NON committare mai il file ".env" (contiene credenziali).

# Chiave API Apify -> https://console.apify.com/account/integrations
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chiave API Anthropic -> https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opzionale: destinatario email per il report (se attivi l'invio email, vedi README)
REPORT_EMAIL_TO=
